<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MindMe" parent="android:Theme.Material.Light.NoActionBar" />
    <style name="Theme.MindMe.Starting" parent="Theme.SplashScreen">
        <!-- Arka plan rengi (Uygulamanın ana mavisi) -->
        <item name="windowSplashScreenBackground">#5B6CFF</item>
        <!-- Ortada görünecek ikon (Uygulama ikonumuz) -->
